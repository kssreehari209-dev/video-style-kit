],
"lines": [
{
"sec": 1,
"i": 0,
"start": 15,
"end": 86,
"text": "2017-ലെ ക്രിസ്മസ് രാത്രി."
},
{
"sec": 1,
"i": 1,
"start": 101,
"end": 280,
"text": "കണ്ണൂർ തീരത്ത് നിന്ന് ഏകദേശം അമ്പത് കിലോമീറ്റർ അകലെ, കടലിൽ നിന്ന് ഒരു ഉപഗ്രഹ സിഗ്നൽ വന്നു."
},
{
"sec": 1,
"i": 2,
"start": 293,
"end": 413,
"text": "ഒമാനിലെ ഗവേഷകർ ടാഗ് ഘടിപ്പിച്ച ലുബാൻ എന്ന പെൺതിമിംഗലം."
},
{
"sec": 1,
"i": 3,
"start": 427,
"end": 602,
"text": "ആയിരത്തഞ്ഞൂറിലേറെ കിലോമീറ്റർ നീന്തി, അറബിക്കടൽ മുറിച്ചുകടന്ന് അവൾ നമ്മുടെ തീരത്തെത്തിയിരിക്കുന്നു."
},
{
"sec": 1,
"i": 4,
"start": 615,
"end": 678,
"text": "ലുബാൻ ഒരു ഹംപ്ബാക്ക് തിമിംഗലമാണ്."
},
{
"sec": 1,
"i": 5,
"start": 691,
"end": 705,
"text": "പല്ലില്ല."
},
{
"sec": 1,
"i": 6,
"start": 717,
"end": 734,
"text": "പാട്ടുപാടും."
},
{
"sec": 1,
"i": 7,
"start": 747,
"end": 823,
"text": "കാണാൻ ആളുകൾ പണം കൊടുത്ത് ബോട്ടിൽ പോകും."
},
{
"sec": 1,
"i": 8,
"start": 834,
"end": 932,
"text": "സൗമ്യനായ ഭീമൻ എന്നാണ് ലോകം ഇതിനെ വിളിക്കുന്നത്."
},
{
"sec": 1,
"i": 9,
"start": 944,
"end": 1106,
"text": "പക്ഷേ ഇതേ ഇനത്തിൽപ്പെട്ട ഒരു തിമിംഗലം ഒരിക്കൽ ഒരു മനുഷ്യനെ ജീവനോടെ വായിലാക്കി."
},
{
"sec": 2,
"i": 0,
"start": 1124,
"end": 1179,
"text": "2021 ജൂൺ."
},
{
"sec": 2,
"i": 1,
"start": 1192,
"end": 1248,
"text": "അമേരിക്കയിലെ കേപ് കോഡ് തീരം."
},
{
"sec": 2,
"i": 2,
"start": 1260,
"end": 1402,
"text": "മൈക്കൽ പാക്കാർഡ് എന്ന ലോബ്സ്റ്റർ മുങ്ങൽക്കാരൻ പതിനാല് മീറ്റർ താഴെ ജോലിയിലായിരുന്നു."
},
{
"sec": 2,
"i": 3,
"start": 1414,
"end": 1466,
"text": "പെട്ടെന്ന് ശക്തമായ ഒരു ഇടി."
},
{
"sec": 2,
"i": 4,
"start": 1479,
"end": 1507,
"text": "ചുറ്റും ഇരുട്ട്."
},
{
"sec": 2,
"i": 5,
"start": 1521,
"end": 1588,
"text": "ആദ്യം മനസ്സിൽ വന്നത് സ്രാവ് എന്നാണ്."
},
{
"sec": 2,
"i": 6,
"start": 1601,
"end": 1663,
"text": "പക്ഷേ പല്ലില്ല, വേദനയില്ല."
},
{
"sec": 2,
"i": 7,
"start": 1676,
"end": 1726,
"text": "ഓക്സിജൻ ഇപ്പോഴും കിട്ടുന്നുണ്ട്."
},
{
"sec": 2,
"i": 8,
"start": 1739,
"end": 1839,
"text": "ചുറ്റും പേശികൾ മുറുകുന്നത് അറിഞ്ഞപ്പോഴാണ് കാര്യം മനസ്സിലായത്."
},
{
"sec": 2,
"i": 9,
"start": 1851,
"end": 1917,
"text": "താൻ ഒരു തിമിംഗലത്തിന്റെ വായ്ക്കുള്ളിലാണ്."
},
{
"sec": 2,
"i": 10,
"start": 1930,
"end": 2076,
"text": "\"തീർന്നു, ഞാൻ മരിച്ചു\" എന്നാണ് അപ്പോൾ തോന്നിയതെന്ന് അദ്ദേഹം പിന്നീട് പറഞ്ഞു."
},
{
"sec": 2,
"i": 11,
"start": 2088,
"end": 2148,
"text": "ഓർമ്മ വന്നത് സ്വന്തം മക്കളെയാണ്."
},
{
"sec": 2,
"i": 12,
"start": 2160,
"end": 2252,
"text": "അകത്തുകിടന്ന് അദ്ദേഹം സർവ്വശക്തിയും എടുത്ത് പിടഞ്ഞു."
},
{
"sec": 2,
"i": 13,
"start": 2264,
"end": 2419,
"text": "മുപ്പത് നാൽപ്പത് സെക്കൻഡ് കഴിഞ്ഞപ്പോൾ തിമിംഗലം മുകളിലേക്ക് വന്ന് അദ്ദേഹത്തെ പുറത്തേക്ക് തുപ്പി."
},
{
"sec": 2,
"i": 14,
"start": 2432,
"end": 2486,
"text": "ദേഹം നിറയെ ചതവുണ്ടായിരുന്നു."
},
{
"sec": 2,
"i": 15,
"start": 2498,
"end": 2539,
"text": "ഒരു എല്ലുപോലും ഒടിഞ്ഞില്ല."
},
{
"sec": 2,
"i": 16,
"start": 2552,
"end": 2658,
"text": "ബൈബിളിലെ യോനായുടെ കഥ കേട്ടവർക്ക് ഇത് പരിചിതമായി തോന്നും."
},
{
"sec": 2,
"i": 17,
"start": 2670,
"end": 2728,
"text": "പക്ഷേ ഇത് നടന്ന സംഭവമാണ്."
},
{
"sec": 2,
"i": 18,
"start": 2740,
"end": 2835,
"text": "ഹംപ്ബാക്ക് മനുഷ്യരെ വേട്ടയാടിയതിന് ഒരു രേഖയുമില്ല."
},
{
"sec": 2,
"i": 19,
"start": 2847,
"end": 2934,
"text": "എന്നിട്ടും ഇതിനോട് മുട്ടിയവരുടെ പട്ടിക ചെറുതല്ല."
},
{
"sec": 2,
"i": 20,
"start": 2946,
"end": 3034,
"text": "കാരണം കേൾക്കുമ്പോഴാണ് ശരിക്കും പേടി തോന്നുക."
},
{
"sec": 2,
"i": 21,
"start": 3046,
"end": 3141,
"text": "മിക്കപ്പോഴും നിങ്ങൾ അവിടെയുണ്ടെന്ന് ഇത് അറിയുന്നുപോലുമില്ല."
},
{
"sec": 3,
"i": 0,
"start": 3154,
"end": 3260,
"text": "ഒരു മുതിർന്ന ഹംപ്ബാക്കിന് ഏകദേശം പതിനഞ്ച് മീറ്റർ നീളമുണ്ട്."
},
{
"sec": 3,
"i": 1,
"start": 3272,
"end": 3332,
"text": "ഒരു കെഎസ്ആർടിസി ബസിനേക്കാൾ നീളം."
},
{
"sec": 3,
"i": 2,
"start": 3345,
"end": 3403,
"text": "ഭാരം മുപ്പത് ടണ്ണിലേറെ വരാം."
},
{
"sec": 3,
"i": 3,
"start": 3416,
"end": 3492,
"text": "അതായത് ആറേഴ് കൊമ്പനാനകളുടെ ഭാരം."
},
{
"sec": 3,
"i": 4,
"start": 3504,
"end": 3595,
"text": "ഇതിന്റെ മുൻചിറകുകൾക്ക് അഞ്ച് മീറ്റർ വരെ നീളമുണ്ടാകും."
},
{
"sec": 3,
"i": 5,
"start": 3607,
"end": 3680,
"text": "രണ്ട് ഓട്ടോറിക്ഷകൾ നിരത്തിയിട്ടാലുള്ള നീളം."
},
{
"sec": 3,
"i": 6,
"start": 3693,
"end": 3770,
"text": "ഒരു തിമിംഗലത്തിനും ഇത്ര നീളമുള്ള ചിറകില്ല."
},
{
"sec": 3,
"i": 7,
"start": 3782,
"end": 3862,
"text": "ദിവസം ഏകദേശം ഒരു ടൺ ഭക്ഷണം വേണം."
},
{
"sec": 3,
"i": 8,
"start": 3874,
"end": 3955,
"text": "പല്ലില്ലാത്ത ഒരു ജീവി അത് എങ്ങനെ സംഘടിപ്പിക്കും?"
},
{
"sec": 4,
"i": 0,
"start": 3990,
"end": 4029,
"text": "ഉത്തരം ലളിതമാണ്."
},
{
"sec": 4,
"i": 1,
"start": 4044,
"end": 4117,
"text": "വായ മലർക്കെ തുറന്ന് ഒറ്റ കുതിപ്പ്."
},
{
"sec": 4,
"i": 2,
"start": 4132,
"end": 4244,
"text": "മീൻകൂട്ടത്തെയോ ക്രില്ലിനെയോ ലക്ഷ്യമാക്കി ഇത് നേരെ പാഞ്ഞുചെല്ലും."
},
{
"sec": 4,
"i": 3,
"start": 4260,
"end": 4358,
"text": "തൊണ്ടയുടെ അടിഭാഗം അക്കോർഡിയൻ പോലെ മടക്കുകളുള്ളതാണ്."
},
{
"sec": 4,
"i": 4,
"start": 4371,
"end": 4443,
"text": "വെള്ളം കയറുമ്പോൾ അത് ബലൂൺ പോലെ വീർക്കും."
},
{
"sec": 4,
"i": 5,
"start": 4457,
"end": 4560,
"text": "ആയിരക്കണക്കിന് ലിറ്റർ വെള്ളം, അതിലുള്ള സകലതും അകത്ത്."
},
{
"sec": 4,
"i": 6,
"start": 4573,
"end": 4705,
"text": "പിന്നെ വായടച്ച്, ബലീൻ എന്ന അരിപ്പയിലൂടെ വെള്ളം പുറത്തേക്ക് ഞെക്കിക്കളയും."
},
{
"sec": 4,
"i": 7,
"start": 4718,
"end": 4754,
"text": "നമ്മുടെ വീശുവല പോലെ."
},
{
"sec": 4,
"i": 8,
"start": 4767,
"end": 4816,
"text": "വെള്ളം പോകും, മീൻ നിൽക്കും."
},
{
"sec": 4,
"i": 9,
"start": 4830,
"end": 4905,
"text": "ഇത് വെറും കരുത്തല്ല, ബുദ്ധിയുമാണ്."
},
{
"sec": 4,
"i": 10,
"start": 4920,
"end": 5112,
"text": "അലാസ്കയിൽ ഒറ്റയ്ക്ക് ഇരതേടുന്ന ഹംപ്ബാക്കുകൾ ക്രില്ലിന് ചുറ്റും വട്ടത്തിൽ കുമിളകൾ ഊതി ഒരു വല തന്നെ ഉണ്ടാക്കും."
},
{
"sec": 4,
"i": 11,
"start": 5126,
"end": 5280,
"text": "2024-ലെ ഒരു പഠനത്തിൽ ഗവേഷകർ ഇവയുടെ ദേഹത്ത് ടാഗ് പിടിപ്പിച്ച് നോക്കി."
},
{
"sec": 4,
"i": 12,
"start": 5293,
"end": 5472,
"text": "വലയുടെ വലിപ്പവും ആഴവും വളയങ്ങളുടെ എണ്ണവും കുമിളകൾ തമ്മിലുള്ള അകലവും ഇവ നിയന്ത്രിക്കുന്നുണ്ട്."
},
{
"sec": 4,
"i": 13,
"start": 5486,
"end": 5499,
"text": "ഫലമോ?"
},
{
"sec": 4,
"i": 14,
"start": 5510,
"end": 5601,
"text": "ഒരു കുതിപ്പിൽ കിട്ടുന്ന ഭക്ഷണം ശരാശരി ഏഴിരട്ടി."
},
{
"sec": 4,
"i": 15,
"start": 5614,
"end": 5661,
"text": "ഗവേഷകരുടെ വാദം ഇതാണ്."
},
{
"sec": 4,
"i": 16,
"start": 5673,
"end": 5735,
"text": "ഈ തിമിംഗലങ്ങൾ ഉപകരണം നിർമ്മിക്കുന്നു."
},
{
"sec": 5,
"i": 0,
"start": 5749,
"end": 5788,
"text": "ഇനി ഇതൊന്ന് സങ്കൽപ്പിക്കൂ."
},
{
"sec": 5,
"i": 1,
"start": 5801,
"end": 5943,
"text": "ആയിരക്കണക്കിന് ചെറുജീവികളെ ലക്ഷ്യമാക്കി മുപ്പത് ടൺ താഴെ നിന്ന് കുതിച്ചുവരുന്നു."
},
{
"sec": 5,
"i": 2,
"start": 5956,
"end": 6035,
"text": "കണ്ണുകൾ തലയുടെ വശങ്ങളിൽ ഏറെ പിന്നിലാണ്."
},
{
"sec": 5,
"i": 3,
"start": 6049,
"end": 6078,
"text": "നിങ്ങൾ ഇരയല്ല."
},
{
"sec": 5,
"i": 4,
"start": 6092,
"end": 6158,
"text": "വഴിയിൽ പെട്ടുപോയ ഒരു സാധനം മാത്രം."
},
{
"sec": 5,
"i": 5,
"start": 6184,
"end": 6242,
"text": "2025 ഫെബ്രുവരി."
},
{
"sec": 5,
"i": 6,
"start": 6255,
"end": 6311,
"text": "ചിലിയിലെ മഗല്ലൻ കടലിടുക്ക്."
},
{
"sec": 5,
"i": 7,
"start": 6325,
"end": 6457,
"text": "അഡ്രിയാൻ സിമാൻകാസ് എന്ന ഇരുപത്തിനാലുകാരൻ അച്ഛനോടൊപ്പം കയാക്കിങ്ങിലായിരുന്നു."
},
{
"sec": 5,
"i": 8,
"start": 6470,
"end": 6535,
"text": "കുറച്ചകലെ നിന്ന് അച്ഛൻ വീഡിയോ എടുക്കുന്നു."
},
{
"sec": 5,
"i": 9,
"start": 6548,
"end": 6599,
"text": "പെട്ടെന്ന് പിന്നിലെ വെള്ളം പിളർന്നു."
},
{
"sec": 5,
"i": 10,
"start": 6612,
"end": 6762,
"text": "ഒരു ഹംപ്ബാക്ക് താഴെ നിന്ന് പൊങ്ങിവന്ന് അഡ്രിയാനെയും കയാക്കിനെയും ഒന്നിച്ച് വായിലാക്കി."
},
{
"sec": 5,
"i": 11,
"start": 6775,
"end": 6836,
"text": "വീഡിയോയിൽ അയാൾ അപ്രത്യക്ഷനാകുന്നു."
},
{
"sec": 5,
"i": 12,
"start": 6850,
"end": 6940,
"text": "ഏതാനും സെക്കൻഡുകൾക്കുള്ളിൽ തിമിംഗലം അയാളെ പുറത്തുവിട്ടു."
},
{
"sec": 5,
"i": 13,
"start": 6953,
"end": 7023,
"text": "ഒരു പോറലുമില്ലാതെ അഡ്രിയാൻ പൊങ്ങിവന്നു."
},
{
"sec": 5,
"i": 14,
"start": 7042,
"end": 7072,
"text": "നല്ല വാർത്ത ഒന്നുണ്ട്."
},
{
"sec": 5,
"i": 15,
"start": 7084,
"end": 7144,
"text": "ഹംപ്ബാക്കിന് നിങ്ങളെ വിഴുങ്ങാൻ കഴിയില്ല."
},
{
"sec": 5,
"i": 16,
"start": 7157,
"end": 7244,
"text": "വായ ഭീമമാണെങ്കിലും തൊണ്ട തീരെ ഇടുങ്ങിയതാണ്."
},
{
"sec": 5,
"i": 17,
"start": 7257,
"end": 7300,
"text": "മനുഷ്യൻ അതിലൂടെ പോകില്ല."
},
{
"sec": 5,
"i": 18,
"start": 7314,
"end": 7353,
"text": "മോശം വാർത്ത ഇതാണ്."
},
{
"sec": 5,
"i": 19,
"start": 7366,
"end": 7529,
"text": "എത്ര നേരം അകത്തുകിടക്കണം, ഏത് ദിശയിലേക്ക് പോകണം എന്നൊക്കെ തീരുമാനിക്കുന്നത് തിമിംഗലമാണ്."
},
{
"sec": 5,
"i": 20,
"start": 7543,
"end": 7629,
"text": "പാക്കാർഡിന്റെ ഭാഗ്യത്തിന് അത് മുകളിലേക്കാണ് പോയത്."
},
{
"sec": 6,
"i": 0,
"start": 7665,
"end": 7741,
"text": "ഹംപ്ബാക്കിനെ കണ്ടുമുട്ടാൻ മറ്റൊരു വഴി കൂടിയുണ്ട്."
},
{
"sec": 6,
"i": 1,
"start": 7756,
"end": 7800,
"text": "ഇത്തവണ മുകളിൽ നിന്നാണ്."
},
{
"sec": 6,
"i": 2,
"start": 7816,
"end": 7926,
"text": "ഇവ ദേഹം മിക്കവാറും മുഴുവനായി വെള്ളത്തിന് മുകളിലേക്ക് എടുത്തെറിയും."
},
{
"sec": 6,
"i": 3,
"start": 7937,
"end": 7991,
"text": "എന്തിനാണെന്ന് ആർക്കും ഉറപ്പില്ല."
},
{
"sec": 6,
"i": 4,
"start": 8006,
"end": 8065,
"text": "മറ്റ് തിമിംഗലങ്ങൾക്കുള്ള സന്ദേശമാകാം."
},
{
"sec": 6,
"i": 5,
"start": 8076,
"end": 8137,
"text": "ദേഹത്തെ പരാദങ്ങളെ കളയാനാകാം."
},
{
"sec": 6,
"i": 6,
"start": 8149,
"end": 8189,
"text": "വെറും രസത്തിനുമാകാം."
},
{
"sec": 6,
"i": 7,
"start": 8202,
"end": 8245,
"text": "ഉറപ്പുള്ളത് ഒന്ന് മാത്രം."
},
{
"sec": 6,
"i": 8,
"start": 8258,
"end": 8317,
"text": "വായുവിലുള്ളത് മുപ്പത് ടണ്ണാണ്."
},
{
"sec": 6,
"i": 9,
"start": 8330,
"end": 8386,
"text": "താഴെ എന്തുണ്ടെന്ന് അത് നോക്കുന്നില്ല."
},
{
"sec": 6,
"i": 10,
"start": 8404,
"end": 8626,
"text": "2024 ജൂലൈയിൽ അമേരിക്കയിലെ ന്യൂ ഹാംഷെയർ തീരത്ത് രണ്ടുപേർ ഒരു ചെറിയ ബോട്ടിൽ മീൻ പിടിക്കുകയായിരുന്നു."
},
{
"sec": 6,
"i": 11,
"start": 8640,
"end": 8811,
"text": "അടുത്തുണ്ടായിരുന്ന കൗമാരക്കാരായ രണ്ട് സഹോദരങ്ങൾ മൊബൈലിൽ പകർത്തിയ രംഗം ലോകം മുഴുവൻ കണ്ടു."
},
{
"sec": 6,
"i": 12,
"start": 8824,
"end": 9000,
"text": "വെള്ളം പൊട്ടിത്തെറിക്കുന്നു, ഒരു ഹംപ്ബാക്ക് ബോട്ടിന്റെ പിൻഭാഗത്ത് വന്നുവീഴുന്നു, ബോട്ട് മറിയുന്നു."
},
{
"sec": 6,
"i": 13,
"start": 9013,
"end": 9099,
"text": "ആ കുട്ടികൾ തന്നെ ഓടിയെത്തി ഇരുവരെയും രക്ഷിച്ചു."
},
{
"sec": 6,
"i": 14,
"start": 9112,
"end": 9141,
"text": "ആർക്കും പരിക്കില്ല."
},
{
"sec": 6,
"i": 15,
"start": 9153,
"end": 9213,
"text": "എല്ലാവർക്കും ഈ ഭാഗ്യം കിട്ടിയില്ല."
},
{
"sec": 6,
"i": 16,
"start": 9229,
"end": 9489,
"text": "2023 സെപ്റ്റംബറിൽ ഓസ്ട്രേലിയയിലെ സിഡ്നിക്കടുത്ത്, രാവിലെ ആറുമണിക്ക്, അഞ്ച് മീറ്ററിൽ താഴെ നീളമുള്ള ഒരു ബോട്ടിൽ രണ്ടുപേർ."
},
{
"sec": 6,
"i": 17,
"start": 9502,
"end": 9628,
"text": "ഒരു തിമിംഗലത്തിന്റെ കുതിപ്പ് ബോട്ടിൽ തട്ടിയതാകാം എന്നാണ് പോലീസ് പറഞ്ഞത്."
},
{
"sec": 6,
"i": 18,
"start": 9640,
"end": 9695,
"text": "ഇരുവരും കടലിലേക്ക് തെറിച്ചുവീണു."
},
{
"sec": 6,
"i": 19,
"start": 9707,
"end": 9764,
"text": "അറുപത്തൊന്നുകാരനായ ഒരാൾ മരിച്ചു."
},
{
"sec": 6,
"i": 20,
"start": 9777,
"end": 9874,
"text": "അത് ഏത് ഇനം തിമിംഗലമായിരുന്നു എന്ന് സ്ഥിരീകരിച്ചിട്ടില്ല."
},
{
"sec": 6,
"i": 21,
"start": 9887,
"end": 9952,
"text": "ഇത്തരം മരണങ്ങൾ വളരെ അപൂർവമാണ്."
},
{
"sec": 6,
"i": 22,
"start": 9963,
"end": 9995,
"text": "പക്ഷേ ഒന്നോർക്കണം."
},
{
"sec": 6,
"i": 23,
"start": 10008,
"end": 10096,
"text": "ഇതൊന്നും സംഭവിക്കാൻ തിമിംഗലം ഉദ്ദേശിക്കണമെന്നില്ല."
},
{
"sec": 7,
"i": 0,
"start": 10107,
"end": 10172,
"text": "ബോട്ടിൽ നിന്ന് ഇറങ്ങിയാൽ അപകടം കുറയുമോ?"
},
{
"sec": 7,
"i": 1,
"start": 10185,
"end": 10194,
"text": "ഇല്ല."
},
{
"sec": 7,
"i": 2,
"start": 10208,
"end": 10354,
"text": "പടിഞ്ഞാറൻ ഓസ്ട്രേലിയയിലെ നിംഗലൂവിൽ ഹംപ്ബാക്കുകൾക്കരികിൽ നീന്താൻ ടൂറുകളുണ്ട്."
},
{
"sec": 7,
"i": 3,
"start": 10367,
"end": 10628,
"text": "2020 ഓഗസ്റ്റിൽ അത്തരമൊരു ടൂറിനിടെ ഇരുപത്തൊമ്പതുകാരിയായ ഒരു യുവതിക്ക് വാരിയെല്ലിന് പൊട്ടലും ആന്തരിക രക്തസ്രാവവും ഉണ്ടായി."
},
{
"sec": 7,
"i": 4,
"start": 10642,
"end": 10762,
"text": "അമ്മത്തിമിംഗലത്തിനും കുഞ്ഞിനും ഇടയിൽ പെട്ടുപോയതാണെന്നാണ് റിപ്പോർട്ടുകൾ."
},
{
"sec": 7,
"i": 5,
"start": 10774,
"end": 10850,
"text": "അവരെ വിമാനത്തിൽ ആശുപത്രിയിലെത്തിക്കേണ്ടിവന്നു."
},
{
"sec": 8,
"i": 0,
"start": 10863,
"end": 10954,
"text": "ഇതുവരെ പറഞ്ഞതെല്ലാം സാധാരണ ദിവസത്തെ കാര്യങ്ങളാണ്."
},
{
"sec": 8,
"i": 1,
"start": 10969,
"end": 11017,
"text": "ഇവ ശരിക്കും വഴക്കിട്ടാലോ?"
},
{
"sec": 8,
"i": 2,
"start": 11030,
"end": 11182,
"text": "പ്രജനനകാലത്ത് ഒരു പെൺതിമിംഗലത്തിന് പിന്നാലെ ആൺതിമിംഗലങ്ങൾ കൂട്ടമായി പായും."
},
{
"sec": 8,
"i": 3,
"start": 11194,
"end": 11244,
"text": "മൂന്ന് മുതൽ ആറ് വരെ എണ്ണം, ചിലപ്പോൾ രണ്ട് ഡസനോളം."
},
{
"sec": 8,
"i": 4,
"start": 11255,
"end": 11342,
"text": "തലകൊണ്ട് ഇടിക്കും, താടികൊണ്ടും വാലുകൊണ്ടും ചിറകുകൊണ്ടും അടിക്കും."
},
{
"sec": 8,
"i": 5,
"start": 11353,
"end": 11434,
"text": "മുഖത്തെ മുഴകൾ ഉരഞ്ഞ് ചോരയൊലിക്കും."
},
{
"sec": 8,
"i": 6,
"start": 11446,
"end": 11516,
"text": "എന്നിട്ടും നിർത്തില്ല."
},
{
"sec": 8,
"i": 7,
"start": 11527,
"end": 11555,
"text": "സൗമ്യനായ ഭീമന്റെ മറ്റൊരു മുഖം."
},
{
"sec": 8,
"i": 8,
"start": 11568,
"end": 11638,
"text": "ഇതേ സമയത്ത് മറ്റ് ആണുങ്ങൾ പാട്ടുപാടുകയാവും."
},
{
"sec": 8,
"i": 9,
"start": 11650,
"end": 11737,
"text": "ഒരു പാട്ടിന് ഇരുപത് മിനിറ്റ് വരെ നീളം."
},
{
"sec": 8,
"i": 10,
"start": 11749,
"end": 11829,
"text": "മണിക്കൂറുകളോളം അത് ആവർത്തിക്കും."
},
{
"sec": 8,
"i": 11,
"start": 11845,
"end": 11918,
"text": "അടുത്ത് നീന്തുന്നവർക്ക് ആ ശബ്ദം ദേഹത്ത് അനുഭവപ്പെടുമത്രേ."
},
{
"sec": 8,
"i": 12,
"start": 11934,
"end": 11994,
"text": "ഏറ്റവും വിചിത്രം ഇതാണ്."
},
{
"sec": 8,
"i": 13,
"start": 12008,
"end": 12047,
"text": "ഈ പാട്ടുകൾ സൂപ്പർഹിറ്റ് സിനിമാഗാനങ്ങൾ പോലെ പടരും."
},
{
"sec": 8,
"i": 14,
"start": 12063,
"end": 12159,
"text": "കിഴക്കൻ ഓസ്ട്രേലിയയിൽ ഒരു പുതിയ പാട്ട് തുടങ്ങിയാൽ ഏകദേശം രണ്ട് വർഷത്തിനുള്ളിൽ ആയിരക്കണക്കിന് കിലോമീറ്റർ അകലെ ഫ്രഞ്ച് പോളിനേഷ്യയിലെ തിമിംഗലങ്ങൾ അതേ പാട്ട് പാടും."
},
{
"sec": 8,
"i": 15,
"start": 12176,
"end": 12258,
"text": "എന്തുകൊണ്ടെന്ന് ആർക്കും കൃത്യമായി അറിയില്ല."
},
{
"sec": 9,
"i": 0,
"start": 12277,
"end": 12393,
"text": "ഇതുവരെ പറഞ്ഞത് നിങ്ങളെ കാണാത്ത തിമിംഗലത്തെക്കുറിച്ചാണ്."
},
{
"sec": 9,
"i": 1,
"start": 12402,
"end": 12541,
"text": "കാണുമ്പോഴാണ് കാര്യം കൂടുതൽ വിചിത്രമാകുന്നത്."
},
{
"sec": 9,
"i": 2,
"start": 12560,
"end": 12760,
"text": "2016-ൽ റോബർട്ട് പിറ്റ്മാൻ എന്ന ഗവേഷകനും സംഘവും ഹംപ്ബാക്കുകളും ഓർക്കകളും തമ്മിലുള്ള 115 ഏറ്റുമുട്ടലുകൾ ശേഖരിച്ചു."
},
{
"sec": 9,
"i": 3,
"start": 12777,
"end": 12930,
"text": "ഓർക്കകൾ വേട്ടയാടുന്നിടത്തേക്ക് ഹംപ്ബാക്കുകൾ പാഞ്ഞുചെന്ന് ആക്രമണം അലങ്കോലമാക്കുന്നത് പലതവണ രേഖപ്പെട്ടിരുന്നു."
},
{
"sec": 9,
"i": 4,
"start": 12946,
"end": 12995,
"text": "ഇത്തരം സംഭവങ്ങളിൽ ഓർക്കകളുടെ ഇരകളിൽ പത്തിൽ ഒമ്പതോളവും ഹംപ്ബാക്കുകളായിരുന്നില്ല."
},
{
"sec": 9,
"i": 5,
"start": 13004,
"end": 13034,
"text": "സീലുകൾ, കടൽസിംഹങ്ങൾ, ഒരു സൺഫിഷ് പോലും."
},
{
"sec": 9,
"i": 6,
"start": 13052,
"end": 13148,
"text": "ഇവ എന്തിനിത് ചെയ്യുന്നു എന്നതിന് പൂർണ്ണമായ ഉത്തരമില്ല."
},
{
"sec": 9,
"i": 7,
"start": 13162,
"end": 13307,
"text": "അതായത് ചുറ്റും നടക്കുന്നതിനെക്കുറിച്ച് ഈ ജീവിക്ക് സ്വന്തമായ അഭിപ്രായങ്ങളുണ്ട്."
},
{
"sec": 9,
"i": 8,
"start": 13321,
"end": 13366,
"text": "അത് നടപ്പാക്കാനും മടിയില്ല."
},
{
"sec": 9,
"i": 9,
"start": 13384,
"end": 13552,
"text": "2017-ൽ കുക്ക് ദ്വീപുകളിൽ തിമിംഗല ഗവേഷകയായ നാൻ ഹൗസർ വെള്ളത്തിലായിരുന്നു."
},
{
"sec": 9,
"i": 10,
"start": 13570,
"end": 13654,
"text": "ഒരു ഹംപ്ബാക്ക് നേരെ വന്ന് അവരെ തള്ളിനീക്കാൻ തുടങ്ങി."
},
{
"sec": 9,
"i": 11,
"start": 13669,
"end": 13694,
"text": "തലകൊണ്ട് ഉന്തി."
},
{
"sec": 9,
"i": 12,
"start": 13707,
"end": 13747,
"text": "ചിറകിനടിയിലാക്കാൻ നോക്കി."
},
{
"sec": 9,
"i": 13,
"start": 13761,
"end": 13820,
"text": "ഒരിക്കൽ വെള്ളത്തിന് മുകളിലേക്ക് ഉയർത്തി."
},
{
"sec": 9,
"i": 14,
"start": 13837,
"end": 13888,
"text": "പത്ത് മിനിറ്റിലേറെ ഇത് തുടർന്നു."
},
{
"sec": 9,
"i": 15,
"start": 13903,
"end": 14080,
"text": "പിന്നെയാണ് അവർ കണ്ടത്, അടുത്തുതന്നെ ഏകദേശം നാലര മീറ്റർ നീളമുള്ള ഒരു ടൈഗർ സ്രാവ്."
},
{
"sec": 9,
"i": 16,
"start": 14096,
"end": 14199,
"text": "തിമിംഗലം തന്നെ സംരക്ഷിക്കുകയായിരുന്നു എന്നാണ് അവർ വിശ്വസിക്കുന്നത്."
},
{
"sec": 9,
"i": 17,
"start": 14213,
"end": 14264,
"text": "എല്ലാവരും അത് അംഗീകരിക്കുന്നില്ല."
},
{
"sec": 9,
"i": 18,
"start": 14278,
"end": 14377,
"text": "ആ തിമിംഗലത്തിന്റെ മനസ്സിൽ എന്തായിരുന്നു എന്ന് നമുക്ക് അറിയില്ല."
},
{
"sec": 9,
"i": 19,
"start": 14390,
"end": 14434,
"text": "പക്ഷേ ഇത് ചിന്തിച്ചുനോക്കൂ."
},
{
"sec": 9,
"i": 20,
"start": 14447,
"end": 14509,
"text": "മുപ്പത് ടൺ ഭാരമുള്ള ഒരു ജീവി നിങ്ങൾക്ക് എന്ത് സംഭവിക്കണമെന്ന് തീരുമാനിക്കുന്നു."
},
{
"sec": 9,
"i": 21,
"start": 14516,
"end": 14588,
"text": "നിങ്ങൾക്ക് അതിൽ ഒരു വോട്ടുമില്ല."
},
{
"sec": 9,
"i": 22,
"start": 14603,
"end": 14654,
"text": "ഇവ നമ്മളോട് സംസാരിക്കാൻ ശ്രമിക്കുന്നുണ്ടാകുമോ?"
},
{
"sec": 9,
"i": 23,
"start": 14671,
"end": 14738,
"text": "2025-ലെ ഒരു പഠനം പതിനൊന്ന് ഹംപ്ബാക്കുകൾ ഊതിയ 39 കുമിളവളയങ്ങൾ രേഖപ്പെടുത്തി."
},
{
"sec": 9,
"i": 24,
"start": 14753,
"end": 14813,
"text": "മിക്കതും ബോട്ടുകൾക്കോ നീന്തുന്നവർക്കോ അടുത്തുവെച്ച്."
},
{
"sec": 9,
"i": 25,
"start": 14823,
"end": 14948,
"text": "കളിയാകാം, സന്ദേശമാകാം, ഒന്നുമില്ലാത്തതുമാകാം."
},
{
"sec": 9,
"i": 26,
"start": 14963,
"end": 15053,
"text": "ഉത്തരം ഇതുവരെ ഇല്ല."
},
{
"sec": 10,
"i": 0,
"start": 15068,
"end": 15122,
"text": "നിങ്ങൾ വെള്ളത്തിലാണ്."
},
{
"sec": 10,
"i": 1,
"start": 15130,
"end": 15163,
"text": "ഒരെണ്ണം നേരെ വരുന്നു."
},
{
"sec": 10,
"i": 2,
"start": 15177,
"end": 15216,
"text": "എന്തുചെയ്യും?"
},
{
"sec": 10,
"i": 3,
"start": 15231,
"end": 15260,
"text": "നീന്തി രക്ഷപ്പെടാമോ?"
},
{
"sec": 10,
"i": 4,
"start": 15272,
"end": 15332,
"text": "ഇതിന്റെ വേഗത്തിന് മുന്നിൽ ഒരു മനുഷ്യനും ഒന്നുമല്ല."
},
{
"sec": 10,
"i": 5,
"start": 15343,
"end": 15373,
"text": "മുങ്ങാമോ?"
},
{
"sec": 10,
"i": 6,
"start": 15386,
"end": 15465,
"text": "അത് നിങ്ങളേക്കാൾ ഏറെനേരം ശ്വാസം പിടിച്ചുനിൽക്കും."
},
{
"sec": 10,
"i": 7,
"start": 15479,
"end": 15495,
"text": "അനങ്ങാതെ കിടക്കാമോ?"
},
{
"sec": 10,
"i": 8,
"start": 15507,
"end": 15590,
"text": "അതാണ് കൂട്ടത്തിൽ നല്ലത്, നിങ്ങൾക്ക് കാണാനാകാത്ത താഴെ നിന്ന് അത് പൊങ്ങിവരുന്നതുവരെ."
},
{
"sec": 10,
"i": 9,
"start": 15603,
"end": 15635,
"text": "തിരിച്ചടിക്കാമോ?"
},
{
"sec": 10,
"i": 10,
"start": 15646,
"end": 15686,
"text": "അത് ഒരാൾ ചെയ്തിട്ടുണ്ട്."
},
{
"sec": 10,
"i": 11,
"start": 15698,
"end": 15803,
"text": "പാക്കാർഡ്."
},
{
"sec": 10,
"i": 12,
"start": 15818,
"end": 15841,
"text": "വായ്ക്കുള്ളിൽ കിടന്ന്."
},
{
"sec": 10,
"i": 13,
"start": 15853,
"end": 15891,
"text": "അത് ഫലിച്ചോ എന്ന് അദ്ദേഹത്തിനുപോലും പറയാനാകില്ല."
},
{
"sec": 10,
"i": 14,
"start": 15903,
"end": 15919,
"text": "ശരിയായ ഉത്തരം വിരസമാണ്."
},
{
"sec": 10,
"i": 15,
"start": 15932,
"end": 15960,
"text": "അകലം പാലിക്കുക."
},
{
"sec": 10,
"i": 16,
"start": 15973,
"end": 16056,
"text": "ഓസ്ട്രേലിയയിലെ നിർദ്ദേശം കുറഞ്ഞത് നൂറ് മീറ്ററാണ്."
},
{
"sec": 10,
"i": 17,
"start": 16068,
"end": 16150,
"text": "കുഞ്ഞുണ്ടെങ്കിൽ മുന്നൂറ് മീറ്റർ."
},
{
"sec": 11,
"i": 0,
"start": 16188,
"end": 16350,
"text": "ന്യായമായി പറഞ്ഞാൽ, ഓരോ വർഷവും ലക്ഷക്കണക്കിന് ആളുകൾ തിമിംഗലങ്ങളെ കാണാൻ പോകുന്നുണ്ട്."
},
{
"sec": 11,
"i": 1,
"start": 16364,
"end": 16466,
"text": "മിക്കവരും ഒരു മങ്ങിയ ഫോട്ടോയുമായി സുഖമായി തിരിച്ചുവരും."
},
{
"sec": 11,
"i": 2,
"start": 16479,
"end": 16567,
"text": "പേടിക്കാൻ കൂടുതൽ കാരണമുള്ളത് തിമിംഗലങ്ങൾക്കാണ്."
},
{
"sec": 11,
"i": 3,
"start": 16581,
"end": 16693,
"text": "വാണിജ്യവേട്ട പല കൂട്ടങ്ങളെയും ഇല്ലാതാക്കുന്നതിന്റെ വക്കിലെത്തിച്ചു."
},
{
"sec": 11,
"i": 4,
"start": 16707,
"end": 16907,
"text": "1986-ലെ ആഗോള നിരോധനത്തിന് ശേഷം പലയിടത്തും എണ്ണം അത്ഭുതകരമായി തിരിച്ചുവന്നു."
},
{
"sec": 11,
"i": 5,
"start": 16918,
"end": 17024,
"text": "അതുകൊണ്ട് കടലിൽ തിമിംഗലങ്ങളും കൂടി, ബോട്ടുകളും കൂടി."
},
{
"sec": 11,
"i": 6,
"start": 17038,
"end": 17087,
"text": "ഇത്തരം കഥകൾ ഇനിയും ഉണ്ടാകും."
},
{
"sec": 11,
"i": 7,
"start": 17100,
"end": 17193,
"text": "പക്ഷേ നമ്മുടെ അറബിക്കടലിലെ കണക്ക് വേറെയാണ്."
},
{
"sec": 11,
"i": 8,
"start": 17209,
"end": 17411,
"text": "ഒമാൻ തീരത്ത് ജീവിക്കുന്ന ഈ ഹംപ്ബാക്കുകൾ ലോകത്തിലെ മറ്റ് ഹംപ്ബാക്കുകളെപ്പോലെ ദീർഘദൂരം ദേശാടനം ചെയ്യാറില്ല."
},
{
"sec": 11,
"i": 9,
"start": 17424,
"end": 17608,
"text": "ഒരു പഠനമനുസരിച്ച് ഏകദേശം എഴുപതിനായിരം വർഷമായി ഇവ മറ്റുള്ളവരിൽ നിന്ന് വേറിട്ടാണ് കഴിയുന്നത്."
},
{
"sec": 11,
"i": 10,
"start": 17621,
"end": 17718,
"text": "ഇന്ന് ഇവ നൂറിൽ താഴെ മാത്രമേയുള്ളൂ എന്നാണ് കണക്ക്."
},
{
"sec": 11,
"i": 11,
"start": 17732,
"end": 17959,
"text": "നല്ല ചിത്രങ്ങൾ കിട്ടിയ 42 തിമിംഗലങ്ങളിൽ മൂന്നിൽ രണ്ടിന്റെയും ദേഹത്ത് മത്സ്യബന്ധന വലയിൽ കുരുങ്ങിയതിന്റെ പാടുകളുണ്ട്."
},
{
"sec": 11,
"i": 12,
"start": 17972,
"end": 18042,
"text": "ആറെണ്ണത്തിന് കപ്പലിടിച്ചതിന്റെ മുറിവുകളും."
},
{
"sec": 12,
"i": 0,
"start": 18060,
"end": 18095,
"text": "ലുബാനെ ഓർമ്മയുണ്ടോ?"
},
{
"sec": 12,
"i": 1,
"start": 18108,
"end": 18272,
"text": "കേരള തീരത്തുകൂടി നീങ്ങിയ അവൾ ഏതാനും ആഴ്ചകൾ നമ്മുടെ കടലിൽ ചെലവഴിച്ച് ഒമാനിലേക്ക് മടങ്ങി."
},
{
"sec": 12,
"i": 2,
"start": 18286,
"end": 18404,
"text": "ഗവേഷകർ തിരഞ്ഞെങ്കിലും ആ സമയത്ത് ആർക്കും അവളെ കണ്ടെത്താനായില്ല."
},
{
"sec": 12,
"i": 3,
"start": 18418,
"end": 18441,
"text": "മൈക്കൽ പാക്കാർഡോ?"
},
{
"sec": 12,
"i": 4,
"start": 18453,
"end": 18583,
"text": "ദേഹം ഭേദമായാൽ ഉടൻ വീണ്ടും ലോബ്സ്റ്റർ പിടിക്കാൻ മുങ്ങുമെന്നാണ് അദ്ദേഹം പറഞ്ഞത്."
},
{
"sec": 12,
"i": 5,
"start": 18598,
"end": 18666,
"text": "ഞാൻ ആണെങ്കിൽ പോസ്റ്റ്കാർഡ് കൊണ്ട് തൃപ്തിപ്പെട്ടേനെ."
},
{
"sec": 12,
"i": 6,
"start": 18679,
"end": 18716,
"text": "കടൽ അവരുടേതാണ്."
},
{
"sec": 12,
"i": 7,
"start": 18728,
"end": 18784,
"text": "വഴിയിൽ നിൽക്കുന്നത് നമ്മളാണ്."
}
]
}